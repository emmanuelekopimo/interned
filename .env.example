# Neon Serverless PostgreSQL connection string (from https://console.neon.tech)
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require



# Secret used to sign session cookies (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL of the site (used in emails and share links)
APP_URL=http://localhost:3000

# Where uploaded files (CVs, logos, images) are stored on disk
UPLOAD_DIR=./uploads

# Gmail / SMTP settings
# For Gmail:
# - SMTP_HOST=smtp.gmail.com
# - SMTP_PORT=465 (or 587)
# - SMTP_USER=your-email@gmail.com
# - SMTP_PASS=your-16-char-google-app-password
# (Sender address automatically defaults to "Internly <SMTP_USER>")
# Optional override: MAIL_FROM="Custom <custom@domain.com>"
# When SMTP_HOST is empty, emails are logged to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM=


# Initial admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@internly.ng
SEED_ADMIN_PASSWORD=Admin@12345

# Secret for the alert digest endpoint (GET /api/cron/alerts with "Authorization: Bearer <secret>")
CRON_SECRET=change-me

